  "unit-mf-all": {
   "id": "unit-mf-all",
   "type": "unit",
   "updatedAt": 1792062571491,
   "classId": "math",
   "quarter": 2,
   "status": "draft",
   "title": "Math Facts · All Facts Review",
   "srcName": "Teacher's math update, 10/15",
   "source": "Math facts (from the teacher's update)",
   "summary": {
    "text": "Every multiplication fact from 0 to 12, mixed together the way the pop quiz will ask them, with a strategy card for each table.",
    "from": "source"
   },
   "why": {
    "text": "The pop quiz takes facts from every table at once. Knowing the sevens inside a set of sevens is not the same as knowing 7 × 8 when it turns up between 3 × 9 and 12 × 4.",
    "from": "added"
   },
   "objectives": [
    {
     "text": "Answer any fact from 0 × 0 to 12 × 12 from memory, in any order.",
     "from": "added"
    },
    {
     "text": "Pick the quickest strategy for a fact you are not sure of.",
     "from": "added"
    },
    {
     "text": "Skip and come back rather than stall on one fact.",
     "from": "added"
    }
   ],
   "parentNote": {
    "text": "The mixed review for the multiplication facts pop quiz (50 facts in 3 minutes). It asks all 66 facts from 2 × 2 to 12 × 12 in one pool, plus the × 0 and × 1 rules, so a round mixes every table the way the real quiz will. The cards are one strategy per table rather than repeats of the fact cards in Sets 1 to 4. Every answer and wrong option was computed, not typed, by the same code that built the sets. The facts run to 12 × 12, which is an assumption until her teacher's sheet arrives; if it stops at 10 × 10, the × 11 and × 12 facts are extra.",
    "from": "added"
   },
   "nextUp": {
    "text": "Take a round of twenty mixed facts, then try the pop quiz sprint.",
    "minutes": 12,
    "from": "added"
   },
   "cards": [
    {
     "id": "c0",
     "term": "Any number × 0",
     "def": "**Always 0.**\n• Zero groups of anything is nothing.\n• 0 × 12 = 0 and 12 × 0 = 0.",
     "hint": "No groups, nothing to count.",
     "from": "added"
    },
    {
     "id": "c1",
     "term": "Any number × 1",
     "def": "**The other number, unchanged.**\n• One group of 9 is just 9.\n• 1 × 11 = 11.",
     "hint": "One group: nothing changes.",
     "from": "added"
    },
    {
     "id": "c2",
     "term": "Any number × 2",
     "def": "**Double the other number.**\n• 2 × 8: 8 + 8 = 16.",
     "hint": "Twins.",
     "from": "added"
    },
    {
     "id": "c3",
     "term": "Any number × 3",
     "def": "**Double it, then add one more group.**\n• 3 × 7: double 7 is 14, plus 7 is 21.",
     "hint": "Two groups and one more.",
     "from": "added"
    },
    {
     "id": "c4",
     "term": "Any number × 4",
     "def": "**Double it, then double again.**\n• 4 × 6: double 6 is 12, double 12 is 24.",
     "hint": "Double, double.",
     "from": "added"
    },
    {
     "id": "c5",
     "term": "Any number × 5",
     "def": "**Half of times 10.**\n• 5 × 8: 10 × 8 = 80, half is 40.\n• The answer always ends in 0 or 5.",
     "hint": "Half of a ten-fact.",
     "from": "added"
    },
    {
     "id": "c6",
     "term": "Any number × 6",
     "def": "**Times 5, plus one more group.**\n• 6 × 7: 5 × 7 = 35, plus 7 is 42.",
     "hint": "One past the fives.",
     "from": "added"
    },
    {
     "id": "c7",
     "term": "Any number × 7",
     "def": "**Times 5 plus times 2.**\n• 7 × 8: 5 × 8 = 40, 2 × 8 = 16, 40 + 16 = 56.",
     "hint": "Five and two make seven.",
     "from": "added"
    },
    {
     "id": "c8",
     "term": "Any number × 8",
     "def": "**Double, double, double.**\n• 8 × 6: 12, then 24, then 48.",
     "hint": "Three doublings.",
     "from": "added"
    },
    {
     "id": "c9",
     "term": "Any number × 9",
     "def": "**Times 10, minus one group.**\n• 9 × 7: 70 − 7 = 63.\n• The digits of the answer add up to 9.",
     "hint": "Ten groups, take one away.",
     "from": "added"
    },
    {
     "id": "c10",
     "term": "Any number × 10",
     "def": "**Add a zero to the end.**\n• 10 × 7 = 70: seven ones become seven tens.",
     "hint": "Ones become tens.",
     "from": "added"
    },
    {
     "id": "c11",
     "term": "Any number × 11",
     "def": "**Times 10, plus one more group.**\n• 11 × 6: 60 + 6 = 66.\n• Up to 11 × 9, the digit just repeats.",
     "hint": "Ten groups and one more.",
     "from": "added"
    },
    {
     "id": "c12",
     "term": "Any number × 12",
     "def": "**Times 10 plus times 2.**\n• 12 × 7: 70 + 14 = 84.",
     "hint": "Ten and two make twelve.",
     "from": "added"
    },
    {
     "id": "c13",
     "term": "Which strategy?",
     "def": "**Use the smaller factor's strategy, unless the other one is easier.**\n• 7 × 2: double 7 is quicker than the sevens.\n• 9 × 6: either works; pick the one you trust.",
     "hint": "Turn the fact around if the other way is easier.",
     "from": "added"
    },
    {
     "id": "c14",
     "term": "The hard ones",
     "def": "**6 × 7 = 42, 6 × 8 = 48, 7 × 8 = 56, 8 × 8 = 64, 7 × 7 = 49.**\n• These are the facts most people miss under a clock.\n• 5, 6, 7, 8: 56 is 7 × 8.",
     "hint": "Say these five out loud until they come without counting.",
     "from": "added"
    },
    {
     "id": "c15",
     "term": "Mixed, against a clock",
     "def": "**Answer the ones you know first, skip the ones you don't.**\n• On paper a skipped fact costs nothing; a stuck one costs the clock.\n• Come back to the skips if time is left.",
     "hint": "Skip, don't stall.",
     "from": "added"
    }
   ],
